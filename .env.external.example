# Modo: PostgreSQL externo (gerenciado ou instalado na máquina).
#   Containers:  make up-external          (ENV_FILE=.env.external por padrão)
#   Local:       ENV_FILE=.env.external make dev-init dev-api
#                ENV_FILE=.env.external make dev-worker
# Copie para .env.external e preencha todas as senhas/segredos.
#
# PostgreSQL instalado na própria máquina, com a API em container:
#   DB_HOST=host.docker.internal  (o compose define extra_hosts host-gateway)
#   e o PostgreSQL precisa aceitar conexões da rede Docker
#   (listen_addresses e pg_hba.conf).

DB_HOST=db.example.internal
DB_PORT=5432
DB_CONTROL_NAME=control
DB_SSLMODE=verify-full
# Caminho relativo: no container ./certs é montado (somente leitura) em /app/certs
# e o WORKDIR é /app; na máquina local, é relativo à raiz do projeto.
DB_SSL_ROOT_CERT=certs/ca.crt
DB_CA_DIR=./certs
DB_CONNECT_RETRY_SECONDS=60

# Com DB_BOOTSTRAP=true, o bootstrap cria roles e o banco control usando estas
# credenciais. Com DB_BOOTSTRAP=false, o DBA cria tudo e o bootstrap só valida
# (as credenciais administrativas não são necessárias).
DB_BOOTSTRAP=false
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_ADMIN_DATABASE=postgres

DB_MIGRATOR_USER=app_migrator
DB_MIGRATOR_PASSWORD=
DB_RUNTIME_USER=app_runtime
DB_RUNTIME_PASSWORD=

API_PORT=8080
API_BIND=127.0.0.1:8080
METRICS_BIND=127.0.0.1:9090
WORKER_METRICS_BIND=127.0.0.1:9091
# Swagger UI em /docs e especificação OpenAPI em /openapi.json. Ligue só em ambientes de teste.
API_DOCS=false
# Atributo Secure do cookie de refresh; desligue só para HTTP sem TLS fora de localhost.
AUTH_COOKIE_SECURE=true
# IPs/CIDRs de proxies cujo X-Forwarded-For é aceito (ex.: o Nginx do front)
TRUSTED_PROXIES=

JWT_ISSUER=simple-core
JWT_PLATFORM_SECRET=
JWT_TENANT_SECRET=

# A API falha ao iniciar se API_INSTANCES × (MAX_OPEN_TENANT_POOLS × TENANT_POOL_MAX_CONNECTIONS
# + CONTROL_POOL_MAX_CONNECTIONS) > max_connections - PG_CONNECTION_RESERVE.
# Ex.: max_connections=100 → 1 × (5 × 10 + 10) = 60 <= 80.
API_INSTANCES=1
CONTROL_POOL_MAX_CONNECTIONS=10
TENANT_POOL_MAX_CONNECTIONS=10
MAX_OPEN_TENANT_POOLS=5
PG_CONNECTION_RESERVE=20

SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=
SEED_TENANT_SLUG=
SEED_TENANT_NAME=
