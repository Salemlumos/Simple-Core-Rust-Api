  "query": "SELECT m.code, m.name,\n             COALESCE((SELECT jsonb_agg(jsonb_build_object('code', f.code, 'name', f.name) ORDER BY f.code)\n                       FROM features f WHERE f.module_id = m.id), '[]'::jsonb) AS \"features!\"\n           FROM modules m ORDER BY m.code",
