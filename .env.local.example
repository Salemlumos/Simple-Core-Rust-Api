# Modo: API e worker na máquina local, PostgreSQL em container (make db-up, dev-init, dev-api, dev-worker).
# Copie para .env.local e preencha todas as senhas/segredos (sem valores padrão).
# Gere segredos com: openssl rand -base64 48

DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONTROL_NAME=control
DB_SSLMODE=disable
DB_SSL_ROOT_CERT=
DB_CONNECT_RETRY_SECONDS=60

# Administrador do PostgreSQL (usado só pelo bootstrap e pelo container postgres).
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_BOOTSTRAP=true

DB_MIGRATOR_USER=app_migrator
DB_MIGRATOR_PASSWORD=
DB_RUNTIME_USER=app_runtime
DB_RUNTIME_PASSWORD=

# Porta publicada pelo container do PostgreSQL (somente 127.0.0.1).
DB_PUBLISH_PORT=5433
POSTGRES_MAX_CONNECTIONS=1150
POSTGRES_SHARED_BUFFERS=1GB

# Na máquina local a API escuta em API_BIND.
API_PORT=8080
API_BIND=127.0.0.1:8080
METRICS_BIND=127.0.0.1:9090
WORKER_METRICS_BIND=127.0.0.1:9091

JWT_ISSUER=simple-core
JWT_PLATFORM_SECRET=
JWT_TENANT_SECRET=

API_INSTANCES=1
CONTROL_POOL_MAX_CONNECTIONS=10
TENANT_POOL_MAX_CONNECTIONS=10
MAX_OPEN_TENANT_POOLS=110
PG_CONNECTION_RESERVE=20

SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
# Mínimo de 16 caracteres.
SEED_OWNER_PASSWORD=
SEED_TENANT_SLUG=
SEED_TENANT_NAME=
